---
interface Props {
  phase: number;
  phaseTitle: string;
  totalPhases: number;
}

const { phase, phaseTitle, totalPhases } = Astro.props;
const progress = Math.round((phase / totalPhases) * 100);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`Phase ${phase}: ${phaseTitle} - Island Todo Branding Blueprint`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <title>Phase {phase}: {phaseTitle} | Island Todo Branding Blueprint</title>
  </head>
  <body class="min-h-screen bg-gray-50">
    <!-- Top Progress Bar -->
    <div class="fixed top-0 left-0 right-0 z-50 h-1 bg-gray-200">
      <div
        class="h-full bg-island-600 transition-all duration-500 ease-out"
        style={`width: ${progress}%`}
      ></div>
    </div>

    <!-- Questionnaire Header -->
    <header class="bg-white border-b border-gray-200 pt-1">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
        <a href="/" class="text-lg font-heading font-bold text-island-800">Island Todo</a>
        <div class="text-center">
          <span class="text-sm text-gray-500">Phase {phase} of {totalPhases}</span>
          <h1 class="text-sm font-medium text-gray-900">{phaseTitle}</h1>
        </div>
        <button id="save-exit-btn" class="text-sm text-gray-500 hover:text-gray-700">
          Save & Exit
        </button>
      </div>
    </header>

    <!-- Phase Sidebar (desktop) + Content -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex gap-8">
      <!-- Sidebar: Phase Navigation -->
      <aside class="hidden lg:block w-56 flex-shrink-0">
        <nav class="sticky top-20 space-y-2">
          {[
            'Your Story',
            'Your Process',
            'Your People',
            'Your Voice',
            'Your Look',
            'Your Position',
            'Your Blueprint',
          ].map((name, i) => (
            <a
              href={`/questionnaire/${i + 1}`}
              class:list={[
                'flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors',
                i + 1 === phase
                  ? 'bg-island-50 text-island-800'
                  : i + 1 < phase
                    ? 'text-island-600 hover:bg-gray-50'
                    : 'text-gray-400',
              ]}
            >
              <span
                class:list={[
                  'w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold',
                  i + 1 === phase
                    ? 'bg-island-700 text-white'
                    : i + 1 < phase
                      ? 'bg-island-200 text-island-800'
                      : 'bg-gray-200 text-gray-500',
                ]}
              >
                {i + 1 < phase ? '✓' : i + 1}
              </span>
              {name}
            </a>
          ))}
        </nav>
      </aside>

      <!-- Main Content -->
      <div class="flex-1 max-w-2xl">
        <slot />
      </div>
    </div>
  </body>
</html>
