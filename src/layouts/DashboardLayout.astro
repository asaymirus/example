---
interface Props {
  brandName?: string;
  brandSlug?: string;
}

const { brandName, brandSlug } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <title>{brandName ? `${brandName} Dashboard` : 'Dashboard'} | Island Todo Branding Blueprint</title>
  </head>
  <body class="min-h-screen bg-gray-50">
    <!-- Dashboard Header -->
    <header class="bg-white border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href="/" class="text-xl font-heading font-bold text-island-800">Island Todo</a>
          {brandName && (
            <span class="text-gray-300">/</span>
            <span class="text-sm font-medium text-gray-700">{brandName}</span>
          )}
        </div>
        <div class="flex items-center gap-4">
          <a href="/dashboard" class="text-sm text-gray-600 hover:text-gray-900">All Brands</a>
          <div class="w-8 h-8 rounded-full bg-island-100 flex items-center justify-center">
            <span class="text-xs font-bold text-island-700">U</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Dashboard Sidebar + Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex gap-8">
      {brandSlug && (
        <aside class="hidden lg:block w-56 flex-shrink-0">
          <nav class="sticky top-8 space-y-1">
            <a href={`/dashboard/${brandSlug}`} class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-white hover:shadow-sm">
              Overview
            </a>
            <a href={`/dashboard/${brandSlug}/guide`} class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-white hover:shadow-sm">
              Brand Guide
            </a>
            <a href={`/dashboard/${brandSlug}/assets`} class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-white hover:shadow-sm">
              Assets
            </a>
            <a href={`/dashboard/${brandSlug}/team`} class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-white hover:shadow-sm">
              Team
            </a>
            <a href={`/dashboard/${brandSlug}/export`} class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-white hover:shadow-sm">
              Export
            </a>
          </nav>
        </aside>
      )}

      <main class="flex-1">
        <slot />
      </main>
    </div>
  </body>
</html>
