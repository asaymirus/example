---
import BaseLayout from '@layouts/BaseLayout.astro';
import { phases } from '@lib/questionnaire-data';
---

<BaseLayout title="Build Your Brand From What You've Already Built">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-island-900 via-island-800 to-island-950 text-white py-20 lg:py-32">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-bold leading-tight mb-6">
        Build Your Brand From<br />What You've Already Built
      </h1>
      <p class="text-lg sm:text-xl text-island-200 max-w-2xl mx-auto mb-10">
        Answer 35 questions about your real business experience.
        Get a complete, personalized Brand Blueprint — not a generic template.
      </p>
      <a href="/start" class="inline-flex items-center justify-center px-8 py-4 rounded-lg bg-white text-island-900 font-bold text-lg hover:bg-island-50 transition-colors">
        Start Your Brand Blueprint
      </a>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center mb-16">How It Works</h2>
      <div class="grid md:grid-cols-3 gap-12">
        <div class="text-center">
          <div class="w-14 h-14 rounded-full bg-island-100 text-island-700 flex items-center justify-center text-xl font-bold mx-auto mb-4">1</div>
          <h3 class="text-lg font-bold mb-2">Tell Your Story</h3>
          <p class="text-gray-600">Answer guided questions about your business journey, processes, customers, and vision.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 rounded-full bg-island-100 text-island-700 flex items-center justify-center text-xl font-bold mx-auto mb-4">2</div>
          <h3 class="text-lg font-bold mb-2">We Build Your Blueprint</h3>
          <p class="text-gray-600">Your answers generate a personalized brand guide with your story, voice, visuals, and positioning.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 rounded-full bg-island-100 text-island-700 flex items-center justify-center text-xl font-bold mx-auto mb-4">3</div>
          <h3 class="text-lg font-bold mb-2">Own Your Brand</h3>
          <p class="text-gray-600">Get a complete workspace with your guide, assets, team access, and exportable documents.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- The 7 Phases -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center mb-4">The 7 Phases</h2>
      <p class="text-gray-600 text-center max-w-2xl mx-auto mb-16">
        Each phase digs deeper into a different dimension of your brand — all drawn from your real experience.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {phases.map((phase) => (
          <div class="card text-center">
            <div class="w-10 h-10 rounded-full bg-island-100 text-island-700 flex items-center justify-center text-sm font-bold mx-auto mb-3">
              {phase.number}
            </div>
            <h3 class="font-bold text-gray-900 mb-2">{phase.title}</h3>
            <p class="text-sm text-gray-500 italic">"{phase.tagline}"</p>
          </div>
        ))}
        <div class="card text-center bg-island-50 border-island-200">
          <div class="w-10 h-10 rounded-full bg-island-700 text-white flex items-center justify-center text-sm font-bold mx-auto mb-3">
            &rarr;
          </div>
          <h3 class="font-bold text-island-900 mb-2">Your Blueprint</h3>
          <p class="text-sm text-island-700">A complete, personalized brand guide.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What You Get -->
  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-heading font-bold text-center mb-16">What You Get</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          { title: 'Brand Origin Story', desc: 'A formatted narrative of your journey and founding story.' },
          { title: 'Customer Persona', desc: 'A detailed profile of your ideal customer based on real interactions.' },
          { title: 'Voice & Tone Guide', desc: 'Communication templates and content pillars derived from how you already talk.' },
          { title: 'Visual Identity Direction', desc: 'Color palette, typography, and mood board rooted in your real environment.' },
          { title: 'Competitive Positioning', desc: 'Your "Only We" statement and market position map.' },
          { title: 'Complete Brand Blueprint', desc: 'A PDF-ready document with everything, plus your own managed workspace.' },
        ].map((item) => (
          <div class="flex gap-4">
            <div class="w-2 h-2 rounded-full bg-island-500 mt-2 flex-shrink-0"></div>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">{item.title}</h3>
              <p class="text-sm text-gray-600">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-16">
        <a href="/start" class="btn-primary text-lg px-10 py-4">
          Start Your Brand Blueprint
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
