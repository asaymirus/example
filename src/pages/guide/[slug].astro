---
import BaseLayout from '@layouts/BaseLayout.astro';

export const prerender = false;
---

<BaseLayout title="Brand Blueprint">
  <div id="guide-container" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Loading state -->
    <div id="loading-state" class="text-center py-20">
      <p class="text-gray-500">Loading your Brand Blueprint...</p>
    </div>

    <!-- No guide state -->
    <div id="no-guide-state" class="text-center py-20 hidden">
      <h2 class="text-2xl font-heading font-bold text-gray-900 mb-3">No Brand Blueprint Found</h2>
      <p class="text-gray-600 mb-6">Complete the questionnaire to generate your brand guide.</p>
      <a href="/start" class="btn-primary">Start Your Brand Blueprint</a>
    </div>

    <!-- Guide content (populated by JS) -->
    <div id="guide-content" class="hidden">
      <!-- Cover -->
      <div class="text-center mb-16 pb-12 border-b border-gray-200">
        <p class="text-sm font-medium text-island-600 mb-2">Brand Blueprint</p>
        <h1 id="guide-brand-name" class="text-4xl sm:text-5xl font-heading font-bold text-gray-900 mb-4"></h1>
        <p id="guide-date" class="text-gray-500"></p>
        <div class="mt-6 flex justify-center gap-3">
          <button id="print-btn" class="btn-secondary text-sm">Print / Save as PDF</button>
          <a href="/dashboard" class="btn-secondary text-sm">Dashboard</a>
        </div>
      </div>

      <!-- Sections -->
      <div id="guide-sections" class="space-y-16"></div>
    </div>
  </div>
</BaseLayout>

<script>
  const GUIDE_STORAGE_KEY = 'island_todo_brand_guide';

  const loadingEl = document.getElementById('loading-state')!;
  const noGuideEl = document.getElementById('no-guide-state')!;
  const contentEl = document.getElementById('guide-content')!;
  const brandNameEl = document.getElementById('guide-brand-name')!;
  const dateEl = document.getElementById('guide-date')!;
  const sectionsEl = document.getElementById('guide-sections')!;

  const guideJson = localStorage.getItem(GUIDE_STORAGE_KEY);

  if (!guideJson) {
    loadingEl.classList.add('hidden');
    noGuideEl.classList.remove('hidden');
  } else {
    try {
      const guide = JSON.parse(guideJson);

      brandNameEl.textContent = guide.brandName;
      dateEl.textContent = `Generated ${new Date(guide.generatedAt).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}`;

      // Render sections
      guide.sections.forEach((section: {
        id: string;
        title: string;
        phase: number;
        content: string;
        subsections: { title: string; content: string }[];
      }) => {
        const sectionEl = document.createElement('section');
        sectionEl.id = section.id;
        sectionEl.className = 'scroll-mt-8';

        const phaseLabel = `Phase ${section.phase}`;

        let subsectionsHtml = '';
        if (section.subsections?.length) {
          subsectionsHtml = section.subsections
            .map(
              (sub) => `
              <div class="bg-gray-50 rounded-lg p-5">
                <h4 class="text-sm font-bold text-gray-700 mb-2">${sub.title}</h4>
                <p class="text-sm text-gray-600 whitespace-pre-line">${sub.content}</p>
              </div>
            `
            )
            .join('');
        }

        sectionEl.innerHTML = `
          <div class="flex items-center gap-2 mb-4">
            <span class="phase-badge bg-island-100 text-island-700 text-xs">${phaseLabel}</span>
          </div>
          <h2 class="text-2xl font-heading font-bold text-gray-900 mb-6">${section.title}</h2>
          <div class="prose prose-gray max-w-none mb-8 whitespace-pre-line">${section.content}</div>
          ${subsectionsHtml ? `<div class="grid sm:grid-cols-2 gap-4">${subsectionsHtml}</div>` : ''}
        `;

        sectionsEl.appendChild(sectionEl);
      });

      loadingEl.classList.add('hidden');
      contentEl.classList.remove('hidden');
    } catch {
      loadingEl.classList.add('hidden');
      noGuideEl.classList.remove('hidden');
    }
  }

  // Print button
  const printBtn = document.getElementById('print-btn');
  if (printBtn) {
    printBtn.addEventListener('click', () => {
      window.print();
    });
  }
</script>

<style>
  @media print {
    header, footer, .btn-secondary, .btn-primary {
      display: none !important;
    }

    #guide-container {
      max-width: 100% !important;
      padding: 0 !important;
    }
  }
</style>
