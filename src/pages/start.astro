---
import BaseLayout from '@layouts/BaseLayout.astro';
import { phases, getTotalQuestions } from '@lib/questionnaire-data';

const totalQuestions = getTotalQuestions();
---

<BaseLayout title="Start Your Brand Blueprint">
  <section class="py-16 lg:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Intro -->
      <div class="text-center mb-16">
        <h1 class="text-3xl sm:text-4xl font-heading font-bold text-gray-900 mb-4">
          Your Brand Blueprint Starts Here
        </h1>
        <p class="text-lg text-gray-600 max-w-xl mx-auto">
          {totalQuestions} questions across 7 phases. Each one draws from your real
          business experience to build a brand guide that's uniquely yours.
        </p>
      </div>

      <!-- Phase Overview -->
      <div class="space-y-4 mb-12">
        {phases.map((phase) => (
          <div class="card flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-island-100 text-island-700 flex items-center justify-center text-sm font-bold flex-shrink-0">
              {phase.number}
            </div>
            <div class="flex-1">
              <h3 class="font-bold text-gray-900">{phase.title}</h3>
              <p class="text-sm text-gray-500 italic mb-2">"{phase.tagline}"</p>
              <p class="text-sm text-gray-600">{phase.intro}</p>
              <div class="mt-3">
                <span class="text-xs font-medium text-gray-400">
                  {phase.questions.length} questions &middot; Generates:
                </span>
                <div class="flex flex-wrap gap-1 mt-1">
                  {phase.generates.map((item) => (
                    <span class="phase-badge bg-gray-100 text-gray-600 text-xs">{item}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Start Button -->
      <div class="text-center space-y-4">
        <a href="/questionnaire/1" class="btn-primary text-lg px-10 py-4 w-full sm:w-auto">
          Begin Phase 1: Your Story
        </a>
        <p class="text-sm text-gray-500">
          Your progress is saved automatically. You can leave and return anytime.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
